{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/vi/album",
      "destination": "/index.html"
    },
    {
      "source": "/vi/album/",
      "destination": "/index.html"
    },
    {
      "source": "/en/album",
      "destination": "/index.html"
    },
    {
      "source": "/en/album/",
      "destination": "/index.html"
    },
    {
      "source": "/ja/album",
      "destination": "/index.html"
    },
    {
      "source": "/ja/album/",
      "destination": "/index.html"
    },
    {
      "source": "/vi",
      "destination": "/index.html"
    },
    {
      "source": "/vi/",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/",
      "destination": "/index.html"
    },
    {
      "source": "/ja",
      "destination": "/index.html"
    },
    {
      "source": "/ja/",
      "destination": "/index.html"
    },
    {
      "source": "/album",
      "destination": "/album/index.html"
    },
    {
      "source": "/album/",
      "destination": "/album/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login/index.html"
    },
    {
      "source": "/admin/login/",
      "destination": "/admin/login/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
