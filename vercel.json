{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ja",
      "destination": "/jp",
      "permanent": true
    },
    {
      "source": "/ja/",
      "destination": "/jp",
      "permanent": true
    },
    {
      "source": "/ja/album",
      "destination": "/jp/album",
      "permanent": true
    },
    {
      "source": "/ja/album/",
      "destination": "/jp/album",
      "permanent": true
    },
    {
      "source": "/ja/invite/:token",
      "destination": "/jp/invite/:token",
      "permanent": true
    },
    {
      "source": "/album",
      "destination": "/vi/album",
      "permanent": true
    },
    {
      "source": "/album/",
      "destination": "/vi/album",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vi/invite/:token",
      "destination": "/index"
    },
    {
      "source": "/vi/invite/:token/",
      "destination": "/index"
    },
    {
      "source": "/en/invite/:token",
      "destination": "/index"
    },
    {
      "source": "/en/invite/:token/",
      "destination": "/index"
    },
